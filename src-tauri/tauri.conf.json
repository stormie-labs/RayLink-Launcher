{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RayLink Launcher",
  "version": "0.2.3",
  "identifier": "app.raylink.launcher",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RayLink Launcher",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
